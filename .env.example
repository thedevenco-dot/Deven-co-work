# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/deven_cowork

# Authentication (JWT Secret)
JWT_SECRET=yoursecretkeyhere

# Admin Default Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Resend Email Configuration (Backend Only - NEVER expose to client)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Deven Co-Work <onboarding@resend.dev>
EMAIL_REPLY_TO=bookings@devencowork.com

# Optional: Vercel Deploy Hook URL. Called after Publish so the static site rebuilds with the new content.
VERCEL_DEPLOY_HOOK_URL=

# ── Spin Wheel ──────────────────────────────────────────────
# Required: already used for signing the short-lived spin token (same JWT_SECRET as above)
# Optional: Google Apps Script web-app URL that appends every spin-wheel lead to a Google Sheet
SPIN_SHEET_WEBHOOK_URL=
# Optional: shared password between this backend and the Apps Script. Must be identical in both places.
SPIN_SHEET_SECRET=
# Optional: extra allowed CORS origin for the standalone wheel (https://spin.devencowork.com is already allowed in code)
CORS_ALLOWED_ORIGIN=
