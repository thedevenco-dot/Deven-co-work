# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/deven_cowork

# Authentication (JWT Secret)
JWT_SECRET=yoursecretkeyhere

# Admin Default Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Resend Email Configuration (Backend Only - NEVER expose to client)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Deven Co-Work <onboarding@resend.dev>
EMAIL_REPLY_TO=bookings@devencowork.com

# Optional: Vercel Deploy Hook URL. Called after Publish so the static site rebuilds with the new content.
VERCEL_DEPLOY_HOOK_URL=

# Spin Wheel Google Sheet Webhook Sync (Optional)
SPIN_SHEET_WEBHOOK_URL=
SPIN_SHEET_SECRET=
